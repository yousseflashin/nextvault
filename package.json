{
  "name": "@nexvault/root",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "start": "npm run start --workspace=@nexvault/desktop",
    "prestart": "node scripts/sync-assets.mjs",
    "test": "jest",
    "start:desktop": "npm run start --workspace=@nexvault/desktop",
    "build:desktop": "npm run build --workspace=@nexvault/desktop",
    "build:mobile": "npm run build --workspace=@nexvault/mobile",
    "build:mobile:android": "npm run build --workspace=@nexvault/mobile && npm exec --workspace=@nexvault/mobile cap sync android && ./apps/mobile/android/gradlew -p apps/mobile/android assembleDebug",
    "build:website": "node scripts/sync-assets.mjs && npm run build --workspace=@nexvault/website",
    "publish:builds": "node scripts/publish-builds.mjs",
    "release": "npm run build:desktop && npm run build:mobile:android && npm run publish:builds && npm run build:website",
    "start:relay": "npm run start --workspace=@nexvault/relay"
  },
  "devDependencies": {
    "jest": "^29.7.0"
  },
  "allowScripts": {
    "electron@38.8.6": true,
    "electron-winstaller@5.4.0": true
  },
  "dependencies": {
    "better-sqlite3-multiple-ciphers": "^13.0.3",
    "electron": "^38.8.6"
  }
}
