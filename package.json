{
  "name": "@nexvault/core",
  "version": "0.1.0",
  "description": "NexVault - Secure local-first password, OTP, and device network system",
  "main": "src/main/main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
      "rebuild:native": "electron-rebuild -f -w better-sqlite3-multiple-ciphers",
      "postinstall": "electron-rebuild -f -w better-sqlite3-multiple-ciphers",
    "relay": "node src/relay/server.js"
  },
  "jest": {
    "testEnvironment": "node",
    "collectCoverageFrom": [
      "src/**/*.js"
    ]
  },
  "dependencies": {
    "better-sqlite3-multiple-ciphers": "^13.0.3",
    "electron-store": "^8.1.0",
    "tweetnacl": "1.0.3",
    "tweetnacl-util": "0.15.1",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.0.1",
    "electron": "^44.7.0",
    "electron-builder": "^24.9.1",
    "jest": "29.7.0"
  },
  "build": {
    "appId": "com.nexvault.app",
    "productName": "NexVault",
    "directories": {
      "output": "dist"
    }
  },
  "allowScripts": {
      "electron@44.7.0": true,
      "better-sqlite3-multiple-ciphers@13.0.3": true
  }
}
