{
  "name": "@nexvault/root",
  "private": true,
  "version": "0.1.11",
  "license": "GPL-3.0-or-later",
  "scripts": {
    "build": "npm run build:website",
    "start:relay": "npm --prefix apps/relay run start",
    "build:relay": "npm --prefix apps/relay run build",
    "test:relay": "npm --prefix apps/relay test",
    "start:desktop": "npm --prefix apps/desktop run start",
    "build:desktop": "npm --prefix apps/desktop run build",
    "start:mobile": "npm --prefix apps/mobile run start",
    "build:mobile": "npm --prefix apps/mobile run build",
    "build:mobile:android": "node scripts/build-mobile-android.mjs",
    "cap:sync": "npm --prefix apps/mobile run cap:sync",
    "cap:open": "npm --prefix apps/mobile run cap:open",
    "cap:run": "npm --prefix apps/mobile run cap:run",
    "start:website": "npm --prefix apps/website run dev",
    "build:website": "node scripts/sync-assets.mjs && npm --prefix apps/website run build",
    "test": "npm run test:core && npm run test:relay",
    "test:core": "npm --prefix packages/core test",
    "prestart": "node scripts/sync-assets.mjs && node scripts/sync-core.mjs",
    "publish:builds": "node scripts/publish-builds.mjs",
    "release": "node scripts/release.mjs",
    "release:upload": "node scripts/upload-release.mjs",
    "release:builds": "npm run build:desktop && npm run build:mobile:android && npm run publish:builds && npm run build:website",
    "ext:firefox": "cp apps/extension/src/manifest.firefox.json apps/extension/src/manifest.json",
    "ext:chrome": "cp apps/extension/src/manifest.chrome.json apps/extension/src/manifest.json"
  },
  "devDependencies": {
    "jest": "^29.7.0"
  }
}
