{
  "name": "@nexvault/root",
  "private": true,
  "version": "0.1.40",
  "license": "GPL-3.0-or-later",
  "scripts": {
    "build": "npm run build:website",
    "start": "npm run start:website",
    "prestart": "npm run sync:assets && npm run sync:core",
    "test": "npm run test:core && npm run test:relay",
    "test:core": "npm --prefix packages/core test",
    "test:relay": "npm --prefix apps/relay test",
    "start:desktop": "npm --prefix apps/desktop run start",
    "build:desktop": "npm --prefix apps/desktop run build",
    "start:mobile": "npm --prefix apps/mobile run start",
    "build:mobile": "npm --prefix apps/mobile run build",
    "build:mobile:android": "node scripts/build-mobile-android.mjs",
    "mobile:sync": "npm --prefix apps/mobile run cap:sync",
    "mobile:open": "npm --prefix apps/mobile run cap:open",
    "mobile:run": "npm --prefix apps/mobile run cap:run",
    "start:relay": "npm --prefix apps/relay run start",
    "build:relay": "npm --prefix apps/relay run build",
    "start:website": "npm --prefix apps/website run dev",
    "build:website": "npm run sync:assets && npm run release:fetch && npm --prefix apps/website run build",
    "sync:assets": "node scripts/sync-assets.mjs",
    "sync:core": "node scripts/sync-core.mjs",
    "release:fetch": "node scripts/fetch-release-info.mjs",
    "release:manifest": "node scripts/generate-release-manifest.mjs --dir release --sync-website",
    "release:builds": "npm run build:desktop && npm run build:mobile:android && npm run release:publish && npm run build:website",
    "release": "node scripts/release.mjs && npm run release:upload",
    "release:upload": "npm run release:builds && node scripts/upload-release.mjs",
    "release:publish": "node scripts/publish-builds.mjs",
    "extension:chrome": "cp apps/extension/src/manifest.chrome.json apps/extension/src/manifest.json",
    "extension:firefox": "cp apps/extension/src/manifest.firefox.json apps/extension/src/manifest.json",
    "extension:pack:firefox": "python3 scripts/pack-firefox-extension.py",
    "cap:sync": "npm run mobile:sync",
    "cap:open": "npm run mobile:open",
    "cap:run": "npm run mobile:run",
    "publish:builds": "npm run release:publish",
    "ext:chrome": "npm run extension:chrome",
    "ext:firefox": "npm run extension:firefox",
    "pack:ext:firefox": "npm run extension:pack:firefox"
  },
  "devDependencies": {
    "jest": "^29.7.0"
  }
}
