{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build:website",
  "outputDirectory": "apps/website/dist",
  "headers": [
    {
      "source": "/release-info.json",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate, no-cache"
        }
      ]
    }
  ]
}

