{
  "name": "@nexvault/desktop",
  "private": true,
  "version": "0.1.44",
  "license": "GPL-3.0-or-later",
  "description": "Decentralized Encrypted P2P Mesh Vault",
  "author": "Youssef Lashin",
  "repository": {
    "type": "git",
    "url": "https://github.com/yousseflashin/nextvault.git"
  },
  "main": "src/main.js",
  "scripts": {
    "prestart": "node ../../scripts/sync-core.mjs",
    "start": "electron . --no-sandbox",
    "build": "electron-builder --publish never"
  },
  "dependencies": {
    "@nexvault/core": "file:../../packages/core",
    "better-sqlite3-multiple-ciphers": "^13.0.3",
    "electron-store": "^8.1.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "electron": "38.8.6",
    "electron-builder": "^26.0.12"
  },
  "desktopName": "nexvault",
  "build": {
    "appId": "com.nexvault.desktop",
    "productName": "NexVault",
    "executableName": "nexvault",
    "publish": {
      "provider": "github",
      "owner": "yousseflashin",
      "repo": "nextvault"
    },
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Utility;Security;",
      "icon": "build/icons",
      "syncDesktopName": true,
      "maintainer": "Youssef Lashin <youssef.mlashin.yml@gmail.com>",
      "synopsis": "Local-First Encrypted Vault & P2P Mesh",
      "description": "NextVault is an encrypted peer-to-peer mesh vault and OTP authenticator with zero cloud servers.",
      "mimeTypes": [
        "x-scheme-handler/nexvault"
      ],
      "desktop": {
        "entry": {
          "StartupWMClass": "nexvault",
          "Keywords": "password;vault;security;authenticator;totp;crypto;nexvault;"
        }
      }
    },
    "files": [
      "src/**/*",
      "build/icons/**/*",
      "../../packages/core/**/*",
      "package.json"
    ]
  }
}
