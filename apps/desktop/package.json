{
  "name": "@nexvault/desktop",
  "private": true,
  "version": "0.1.5",
  "license": "GPL-3.0-or-later",
  "description": "Local-First Encrypted Vault & P2P Mesh",
  "author": "Youssef Lashin",
  "repository": {
    "type": "git",
    "url": "https://github.com/yousseflashin/nextvault.git"
  },
  "main": "src/main.js",
  "scripts": {
    "prestart": "node ../../scripts/sync-core.mjs",
    "start": "electron . --no-sandbox",
    "build": "electron-builder --publish never"
  },
  "dependencies": {
    "@nexvault/core": "file:../../packages/core",
    "better-sqlite3-multiple-ciphers": "^13.0.3",
    "electron-store": "^8.1.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "electron": "38.8.6",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.nexvault.desktop",
    "productName": "NexVault",
    "executableName": "nexvault",
    "publish": {
      "provider": "github",
      "owner": "yousseflashin",
      "repo": "nextvault"
    },
    "directories": {
      "output": "dist"
    },
    "linux": {
      "target": [
        "AppImage",
        "dir"
      ]
    },
    "files": [
      "src/**/*",
      "../../packages/core/**/*",
      "package.json"
    ]
  }
}
