{
  "name": "@nexvault/desktop",
  "private": true,
  "version": "0.1.0",
  "main": "src/main.js",
  "scripts": {
    "prestart": "node ../../scripts/sync-core.mjs",
    "start": "electron . --no-sandbox",
    "build": "electron-builder"
  },
  "dependencies": {
    "@nexvault/core": "file:../../packages/core",
    "better-sqlite3-multiple-ciphers": "^13.0.3",
    "electron-store": "^8.1.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "electron": "38.8.6",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.nexvault.desktop",
    "productName": "NexVault",
    "executableName": "nexvault",
    "directories": {
      "output": "dist"
    },
    "linux": {
      "target": [
        "dir"
      ]
    },
    "files": [
      "src/**/*",
      "../../packages/core/**/*",
      "package.json"
    ]
  }
}