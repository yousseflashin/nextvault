<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="@drawable/autofill_dataset_background"
    android:padding="10dp">

    <!-- Icon Badge -->
    <ImageView
        android:id="@+id/autofill_icon"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:background="@drawable/autofill_icon_badge"
        android:padding="7dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_nexvault_key"
        android:contentDescription="NexVault Autofill" />

    <!-- Text Information -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="8dp">

        <TextView
            android:id="@+id/autofill_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Saved Login"
            android:textColor="#F8FAFC"
            android:textSize="14sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/autofill_subtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Autofill credentials"
            android:textColor="#94A3B8"
            android:textSize="12sp"
            android:maxLines="1"
            android:ellipsize="end" />
    </LinearLayout>

    <!-- Brand Tag -->
    <TextView
        android:id="@+id/autofill_badge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/autofill_brand_badge"
        android:text="NEXVAULT"
        android:textColor="#00F0FF"
        android:textSize="10sp"
        android:textStyle="bold"
        android:letterSpacing="0.05" />
</LinearLayout>
