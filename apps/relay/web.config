<?xml version="1.0" encoding="UTF-8"?>
<!-- MonsterASP.NET IIS handler for NexVault relay -->
<configuration>
  <system.webServer>
    <handlers>
      <add name="iisnode" path="index.js" verb="*" modules="iisnode" />
    </handlers>

    <!-- Route everything to the Node relay -->
    <rewrite>
      <rules>
        <rule name="Relay">
          <match url="/*" />
          <action type="Rewrite" url="index.js" />
        </rule>
      </rules>
    </rewrite>

    <!-- WebSocket support (required for NexVault signaling) -->
    <webSocket enabled="true" />

    <!-- iisnode settings -->
    <iisnode
      nodeProcessCommandLine="node.exe"
      interceptor="%programfiles%\iisnode\interceptor.js"
      watchedFiles="*.js"
      devErrorsEnabled="false"
      loggingEnabled="false"
      maxConcurrentRequestsPerCPU="1024"
      maxNamedPipeConnectionRetry="100"
      asyncCompletionThreadCount="0"
      initialRequestBufferSize="4096"
      maxRequestBufferSize="65536"
      uncFileChangesPollingInterval="5000"
      gracefulShutdownTimeout="60000"
      promoteServerVars="LOGON_USER"
    />

    <!-- Security: hide node internals -->
    <security>
      <requestFiltering>
        <hiddenSegments>
          <add segment="node_modules" />
        </hiddenSegments>
      </requestFiltering>
    </security>

    <httpErrors existingResponse="PassThrough" />
  </system.webServer>
</configuration>
