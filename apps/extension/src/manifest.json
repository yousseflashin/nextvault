{
  "manifest_version": 3,
  "name": "NexVault Password Manager",
  "version": "0.1.0",
  "description": "Connects browser autofill workflows to the local NexVault desktop vault.",
  "permissions": ["storage", "activeTab", "scripting"],
  "host_permissions": ["<all_urls>"],
 "background": {
  "scripts": ["background.js"],
  "service_worker": "background.js"
},
  "action": {
    "default_popup": "popup.html",
    "web_accessible_resources": [
      {
        "resources": ["cyber/cyber.css", "cyber/binary-shield.js"],
        "matches": ["<all_urls>"]
      }
    ]
    },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
